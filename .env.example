PROJECT_NAME=VelibPulse Data Lake
ENVIRONMENT=development
LOG_LEVEL=INFO

# MinIO (zone raw compatible S3)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=velib
S3_SECRET_KEY=velib-secret
S3_REGION=eu-west-3
S3_RAW_BUCKET=raw

# PostgreSQL (schemas staging et curated)
DATABASE_URL=postgresql+psycopg2://velib:velib@postgres:5432/velib

# Source API sans cle
VELIB_STATUS_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_status.json
REFERENCE_CSV_PATH=/app/data/source/stations_reference.csv
HTTP_TIMEOUT_SECONDS=30

# API
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
